#!/usr/bin/env bash
# Pull the logo-labeller repo and deploy what it holds: code (via setup_vm.sh), images, pairs.
# Run on the VM: sudo labelweb-sync
# Pairs are only ever added (load-pairs is INSERT OR IGNORE); to replace a pair set, reset the db.
set -euo pipefail
CLONE=${LABELWEB_CLONE:-/home/ubuntu/logo-labeller}

sudo -u ubuntu git -C "$CLONE" pull --ff-only
bash "$CLONE/similarity_labelling/deploy/setup_vm.sh"

if [ -d "$CLONE/data/images" ]; then
  rsync -a --chown=labelweb:labelweb --chmod=D755,F644 "$CLONE/data/images/" /srv/labelweb/images/
fi
if [ -d "$CLONE/audit" ]; then
  rsync -a --chown=labelweb:labelweb --chmod=D755,F644 "$CLONE/audit/" /srv/labelweb/audit/
fi
if [ -f "$CLONE/data/pairs.csv" ]; then
  install -o labelweb -g labelweb -m 640 "$CLONE/data/pairs.csv" /srv/labelweb/data/pairs.csv
  labelweb-admin load-pairs /srv/labelweb/data/pairs.csv
fi
echo "synced $(sudo -u ubuntu git -C "$CLONE" log -1 --format='%h %s')"
